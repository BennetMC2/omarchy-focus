{
  "schemaVersion": 1,
  "id": "local.focus",
  "name": "Bouncer: Focus To-Do List",
  "version": "2.3.0-beta.1",
  "author": "Bennet",
  "description": "A to-do list that keeps you focused. Your distracting sites and apps stay blocked until an agent has checked that today's tasks are done.",
  "license": "MIT",
  "kinds": [
    "service",
    "bar-widget",
    "panel",
    "overlay"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Focus.qml",
    "panel": "TaskPanel.qml",
    "overlay": "FocusOverlay.qml"
  },
  "barWidget": {
    "displayName": "Bouncer",
    "description": "Today's progress",
    "category": "Plugin",
    "allowMultiple": false,
    "defaultSection": "center"
  }
}
